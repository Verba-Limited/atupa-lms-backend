NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/atupa_lms

# Auth: use long random values (32+ chars) in production; they must differ.
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# First super admin (created once if none exists). Super admins cannot self-register.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# URLs
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed origins; empty = allow all (development only)
CORS_ORIGINS=

# Email (Resend). Without a key, emails are printed to the log in development.
RESEND_API_KEY=
EMAIL_FROM=ATUPA LMS <no-reply@atupa.ng>

# Payments (Paystack). Webhook URL: {APP_BASE_URL}/api/v1/subscriptions/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Media (Cloudinary). Without these, files are stored on local disk (development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=atupa-lms
MEDIA_UPLOAD_DIR=uploads

# Seeding & jobs
SEED_DEMO_CONTENT=true
LEARNING_REMINDERS_ENABLED=true
